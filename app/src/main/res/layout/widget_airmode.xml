<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_device_icon" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_airmode" android:tint="@color/widget_primary" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="@string/app_name" android:textSize="18sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/no_airpods" android:textSize="12sp" android:textColor="@color/widget_secondary"
        android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:id="@+id/widget_buds" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp" android:layout_marginBottom="8dp"
        android:padding="8dp" android:background="@drawable/widget_battery">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_popup_earbud"
                    android:tint="@color/widget_secondary" android:importantForAccessibility="no" />
                <TextView android:id="@+id/widget_left_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:text="@string/battery_left" android:textSize="12sp" android:textColor="@color/widget_secondary" />
            </LinearLayout>
            <TextView android:id="@+id/widget_left_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textSize="30sp" android:fontFamily="sans-serif-medium" android:gravity="center"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp"
                android:maxLines="1" android:textColor="@color/widget_text" />
            <TextView android:id="@+id/widget_left_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="16dp"
                android:textSize="11sp" android:textColor="@color/widget_secondary" android:gravity="center" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_popup_case"
                    android:tint="@color/widget_secondary" android:importantForAccessibility="no" />
                <TextView android:id="@+id/widget_case_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:text="@string/battery_case" android:textSize="12sp" android:textColor="@color/widget_secondary" />
            </LinearLayout>
            <TextView android:id="@+id/widget_case_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textSize="30sp" android:fontFamily="sans-serif-medium" android:gravity="center"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp"
                android:maxLines="1" android:textColor="@color/widget_text" />
            <TextView android:id="@+id/widget_case_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="16dp"
                android:textSize="11sp" android:textColor="@color/widget_secondary" android:gravity="center" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_popup_earbud"
                    android:tint="@color/widget_secondary" android:importantForAccessibility="no" />
                <TextView android:id="@+id/widget_right_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:text="@string/battery_right" android:textSize="12sp" android:textColor="@color/widget_secondary" />
            </LinearLayout>
            <TextView android:id="@+id/widget_right_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textSize="30sp" android:fontFamily="sans-serif-medium" android:gravity="center"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp"
                android:maxLines="1" android:textColor="@color/widget_text" />
            <TextView android:id="@+id/widget_right_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="16dp"
                android:textSize="11sp" android:textColor="@color/widget_secondary" android:gravity="center" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_headset" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
        android:layout_marginTop="10dp" android:layout_marginBottom="8dp" android:padding="12dp" android:background="@drawable/widget_battery">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_headset"
            android:tint="@color/widget_primary" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/widget_headset_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/battery_headset" android:textSize="12sp" android:textColor="@color/widget_secondary" />
            <TextView android:id="@+id/widget_headset_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textSize="36sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_text" />
            <TextView android:id="@+id/widget_headset_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="16dp"
                android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_modes_top" android:layout_width="match_parent" android:layout_height="50dp"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/widget_off" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
            android:background="@drawable/widget_mode" android:text="@string/mode_off"
            android:textColor="@color/widget_text" android:textSize="13sp" android:fontFamily="sans-serif-medium"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
            android:gravity="center" android:textAllCaps="false" android:padding="6dp" android:maxLines="1" android:ellipsize="end" android:clickable="true" />
        <Button android:id="@+id/widget_anc" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
            android:background="@drawable/widget_mode" android:text="@string/mode_anc"
            android:textColor="@color/widget_text" android:textSize="13sp" android:fontFamily="sans-serif-medium"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
            android:gravity="center" android:textAllCaps="false" android:padding="6dp" android:maxLines="1" android:ellipsize="end" android:clickable="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_modes_bottom" android:layout_width="match_parent" android:layout_height="50dp"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/widget_transparency" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
            android:background="@drawable/widget_mode" android:text="@string/mode_transparency"
            android:textColor="@color/widget_text" android:textSize="13sp" android:fontFamily="sans-serif-medium"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
            android:gravity="center" android:textAllCaps="false" android:padding="6dp" android:maxLines="1" android:ellipsize="end" android:clickable="true" />
        <Button android:id="@+id/widget_adaptive" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
            android:background="@drawable/widget_mode" android:text="@string/mode_adaptive"
            android:textColor="@color/widget_text" android:textSize="13sp" android:fontFamily="sans-serif-medium"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
            android:gravity="center" android:textAllCaps="false" android:padding="6dp" android:maxLines="1" android:ellipsize="end" android:clickable="true" />
    </LinearLayout>
</LinearLayout>
